# Python Backend
# ==============================================================================
backend/.venv/
backend/venv/
backend/env/
backend/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/
backend/aura_voice.db
*.db
*.sqlite
*.sqlite3

