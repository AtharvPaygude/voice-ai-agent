# Aura Voice AI — Backend Configuration Template
# Copy this file to .env and replace the values with your actual credentials.
# NEVER commit the actual .env file to version control.

# Application
APP_NAME=Aura Voice AI
DEBUG=true

# Database (PostgreSQL / Supabase or SQLite)
# Example PostgreSQL: postgresql://username:password@localhost:5432/aura_db
# Example SQLite: sqlite+aiosqlite:///./aura_voice.db
DATABASE_URL=postgresql://username:password@localhost:5432/aura_db

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# STT (faster-whisper)
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS (edge-tts / azure)
TTS_ENGINE=edge-tts

# Language Detection
LANGUAGE_SWITCH_CONFIDENCE_THRESHOLD=0.7
LANGUAGE_SWITCH_STABILITY_COUNT=2

# RAG & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
GEMINI_API_KEY=your_gemini_api_key_here

# Escalation / Support
SUPPORT_PHONE=+91-98765-43210
SUPPORT_HOURS=Mon-Sat 9:00-18:00 IST
PUBLIC_API_URL=http://localhost:8000

# SMTP (for escalation notification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@aura.ai
